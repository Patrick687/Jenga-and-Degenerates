# One-time setup on the droplet. Copy to /etc/systemd/system/jenga-api.service
# and replace YOUR_DEPLOY_USER (the output of `whoami`) (Node 22 lives in /opt/node-22, see README).
[Unit]
Description=Jenga & Degenerates API
After=network.target

[Service]
Type=simple
User=YOUR_DEPLOY_USER
WorkingDirectory=/var/www/jenga-api
EnvironmentFile=/var/www/jenga-api/.env
Environment=NODE_ENV=production
ExecStart=/opt/node-22/bin/node dist/src/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
