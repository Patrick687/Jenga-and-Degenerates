# The public URL of your deployed site. The QR code points here.
# Set this BEFORE running `npm run build`; Vite inlines it at build time.
# Example: VITE_PUBLIC_APP_URL=https://mybirthdaydomain.com
VITE_PUBLIC_APP_URL=

# Optional: full URL of the GraphQL API. Leave empty to use the same-origin /graphql
# (the Vite dev/preview servers proxy it to the backend).
VITE_API_URL=

# Optional: where the Assassin game lives, for the door QR code on /assassin/host.
# Leave empty to use VITE_PUBLIC_APP_URL + /assassin.
# Example: VITE_ASSASSIN_URL=https://assassin.mybirthdaydomain.com
VITE_ASSASSIN_URL=
