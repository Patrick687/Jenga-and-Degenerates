# Copy to .env and fill in. Never commit .env.

# Password for the card manager page. Required. Use something long: 8+ characters.
ADMIN_PASSWORD=

# Port and host the API listens on. Host defaults to 127.0.0.1 so only nginx on
# the same machine can reach it.
PORT=4000
HOST=127.0.0.1

# SQLite database file. Relative paths are resolved from the backend folder.
DATABASE_URL=file:./data/jenga.db

# Optional: comma-separated origins allowed to call the API cross-origin.
# Not needed when the frontend and API share one domain (the normal setup).
# CORS_ORIGIN=http://localhost:5173
